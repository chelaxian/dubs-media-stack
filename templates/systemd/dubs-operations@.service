# Dubs panel — operations role (episode retry/monitor loop).
# Talks to Sonarr/Transmission APIs; all WRITES go through those APIs (torrents
# are added over the Transmission RPC, library changes over the Sonarr API).
# The compose PGID media group is a supplementary group ONLY so the space
# guard can statvfs/read the torrent and shows mounts (storage_ready); the
# systemd sandbox keeps every media path read-only here. Runs on the backend
# uid with the private backend group (owns the transmission/prowlarr
# credentials it needs) plus the shared status group (reads web-owned
# preferences and the web's job-request markers).
# systemctl enable dubs-operations@main

[Unit]
Description=Dubs operations role (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@WORKER_USER@
Group=@BACKEND_GROUP@
# Shared status group (read web-owned preferences, write public job output)
# + compose PGID media group (READ-ONLY media access for the space guard).
SupplementaryGroups=@SHARED_GROUP@ @MEDIA_GROUP@
Environment=SERIES_CONTROL_ROLE=operations
Environment=SERIES_CONTROL_CONFIG_ROOT=@CONFIG_ROOT@
Environment=SERIES_CONTROL_STATE_ROOT=@STATE_ROOT@
Environment=SERIES_CONTROL_WORKER_ROOT=@WORKER_ROOT@
Environment=SERIES_CONTROL_UI_DIR=@REPO@/src
Environment=SERIES_CONTROL_STUDIOS=@STUDIOS@
Environment=SERIES_CONTROL_FEED_STATE=@FEED_STATE@
Environment=SERIES_CONTROL_COVERS=@COVERS@
Environment=PYTHONPATH=@REPO@/src
ExecStart=@PYTHON@ @REPO@/src/control.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@WORKER_ROOT@ @COVERS@
ReadOnlyPaths=@STATE_ROOT@ @CONFIG_ROOT@ @FEED_STATE@ -@TORRENT_HOST@ -@SHOWS_HOST@

[Install]
WantedBy=multi-user.target
