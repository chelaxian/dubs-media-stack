# Dubs media stack — compose variables.
# Copy to compose/.env and fill in before `docker compose up -d`.
# Absolute paths are enforced (fail-closed) to prevent wrong mounts.

# --- identities ---------------------------------------------------------

# Numeric uid/gid that own the media storage and service configs.
# All containers run with these so files stay consistently owned.
# On the host: id -u / id -g of the account that owns the storage.
PUID=1000
PGID=1000

TZ=Europe/Moscow

# --- storage ------------------------------------------------------------

# Persistent media storage root. Subdirs torrents/ shows/ movies/ music/
# must exist (installer/dubs prepare-storage can create them).
# The stack refuses to start until <MEDIA_ROOT>/.dubs-storage-ok exists:
#   install -m 0644 /dev/null "$MEDIA_ROOT/.dubs-storage-ok"
MEDIA_ROOT=

# Absolute path for service configuration directories (Sonarr, Radarr, ...).
# Typically on the same persistent storage or a separate config volume.
DUBS_DATA_ROOT=

# --- network ------------------------------------------------------------

# IP to bind all HTTP endpoints to. Default keeps every service loopback-only
# (the reverse proxy on the same host publishes them).
BIND_IP=127.0.0.1

# BitTorrent peer port binding. Must be reachable from other peers, so it is
# public by default; restrict to your LAN if you must.
PEER_BIND_IP=0.0.0.0

# --- Transmission RPC credentials ---------------------------------------

# The installer generates both (secrets.token_urlsafe) into compose/.env on
# first run if empty; the panel and the daemon must match. Values are never
# printed to stdout. Leave empty here and let the installer fill them, or set
# your own strong values.
TRANSMISSION_USER=
TRANSMISSION_PASS=

# --- images -------------------------------------------------------------

# Overridable image references; defaults are the upstream images.
# Pin digests for reproducibility if you want tightly controlled updates.
JELLYFIN_IMAGE=jellyfin/jellyfin:latest
SONARR_IMAGE=lscr.io/linuxserver/sonarr:latest
RADARR_IMAGE=lscr.io/linuxserver/radarr:latest
LIDARR_IMAGE=lscr.io/linuxserver/lidarr:latest
TRANSMISSION_IMAGE=lscr.io/linuxserver/transmission:latest
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:latest
JACKETT_IMAGE=lscr.io/linuxserver/jackett:latest
FLARESOLVERR_IMAGE=flaresolverr/flaresolverr:latest
SENTINEL_IMAGE=busybox:1.36

# Official Seerr image (https://docs.seerr.dev/getting-started/docker/).
# The image runs as UID/GID 1000: the seerr config dir must be owned by
# PUID/PGID (the installer creates it for you).
SEERR_IMAGE=ghcr.io/seerr-team/seerr:latest

FLARESOLVERR_LOG_LEVEL=info

# --- iGPU override (compose/docker.igpu.yml) ----------------------------

# Only needed when enabling docker.igpu.yml:
# RENDER_GID=$(getent group render | cut -d: -f3)
RENDER_GID=
